    <Member MemberName="EnableArchivedCollectionFallback">
      <MemberSignature Language="C#" Value="public bool EnableArchivedCollectionFallback { get; set; }" />
      <MemberSignature Language="ILAsm" Value=".property instance bool EnableArchivedCollectionFallback" />
      <MemberSignature Language="DocId" Value="P:Azure.Security.ConfidentialLedger.ConfidentialLedgerClientOptions.EnableArchivedCollectionFallback" />

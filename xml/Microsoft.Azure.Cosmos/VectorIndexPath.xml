  <Docs>
    <summary>
            DOM for a vector index path. A vector index path is used in a vector index.
            </summary>
    <remarks>To be added.</remarks>
    <example><![CDATA[
            "indexingPolicy": {
                "includedPaths": [
                    {
                        "path": "/*"
                    }
                ],
                "excludedPaths": [
                    {
                        "path": "/embeddings/vector/*"
                    }
                ],
                "vectorIndexes": [
                    {
                        "path": "/vector1",
                        "type": "flat"
                    },
                    {
                        "path": "/vector2",
                        "type": "quantizedFlat",
                        "quantizationByteSize": 3,
                        "vectorIndexShardKey": ["/ZipCode"]
                    },
                    {
                        "path": "/embeddings/vector",
                        "type": "DiskANN",
                        "quantizerType": "product",  // or "spherical"
                        "quantizationByteSize": 2,
                        "indexingSearchListSize": 100,
                        "vectorIndexShardKey": ["/Country"]
                    }
                ]
            }
            ]]></example>
  </Docs>
